# Copy to .env and fill in. .env is gitignored — never commit it.

# Hugging Face access token with read access to the private model repo.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults to dharuntsk/deberta-fakenews-trust in src/config.py.
# Only set this to point at a different model repo.
# HF_REPO=dharuntsk/deberta-fakenews-trust

# Optional. Comma-separated list of origins allowed to call the API.
# Unset means "*", which is fine locally. Set it to the deployed site origin
# in production, e.g. https://your-site.onrender.com
# ALLOWED_ORIGINS=*
